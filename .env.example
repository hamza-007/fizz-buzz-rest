# Copy to .env (committed defaults) or .env.local (developer overrides).
#
# Precedence, lowest to highest: these defaults, .env, .env.local, then the
# real environment. Every variable below already holds its default value, so
# the server runs with no .env at all. A malformed value aborts start-up.

# development | staging | production. Unset behaves as development, which
# switches the logs from JSON to a readable text format.
ENVIRONMENT=development

# Listen port. The serve command's --port flag overrides it.
APP_PORT=8080

# Server timeouts. All must be positive durations (10s, 1m, ...).
APP_READ_HEADER_TIMEOUT=5s
APP_READ_TIMEOUT=10s
APP_WRITE_TIMEOUT=30s
APP_IDLE_TIMEOUT=60s
# Grace period for in-flight requests on SIGTERM.
APP_SHUTDOWN_TIMEOUT=10s
# Per-request deadline. Must stay shorter than APP_WRITE_TIMEOUT.
APP_REQUEST_TIMEOUT=20s

# debug | info | warn | error. The --verbose flag, or VERBOSE=true, forces debug.
APP_LOG_LEVEL=info
# VERBOSE=false

# Browser origins allowed to call the API, comma separated. Empty means the
# CORS middleware is not installed at all, so no cross-origin access.
APP_CORS=

# Only enable behind a proxy that overwrites X-Forwarded-For: clients can forge
# it, and the rate limiter keys on the client IP.
APP_TRUST_PROXY=false

# Requests allowed per IP and per window, on /api/v1 only. 0 disables
# throttling; the window must be a positive duration.
APP_RATE_LIMIT=100
APP_RATE_WINDOW=1m

# Caps the "limit" parameter, bounding the response size. Must be positive: an
# uncapped limit lets one request ask for a slice of billions of entries.
FIZZBUZZ_MAX_LIMIT=100000

# Caps the distinct requests kept in memory for the statistics. 0 means
# unbounded, which lets a client grow the map with unique parameter sets.
FIZZBUZZ_MAX_STATS_KEYS=10000
